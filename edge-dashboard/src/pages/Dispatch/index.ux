<template>
  <div class="screen">
    <!-- ============ 标题栏 ============ -->
    <div class="topbar">
      <div class="back" onclick="goBack">
        <text class="back-text">返回</text>
      </div>
      <text class="topbar-title">巡检调度台</text>
      <div class="chip">
        <text class="chip-text">{{headline}}</text>
      </div>
    </div>

    <div class="body">
      <!-- ============ 左：4 台车辆的状态卡 ============ -->
      <div class="left">
        <text class="section-title">车辆与区域</text>
        <div class="cars">
          <div class="car" for="{{cars}}">
            <div class="car-head">
              <text class="car-id">{{$item.id}}</text>
              <div class="dot" style="{{$item.dotStyle}}"></div>
              <text class="car-link" style="{{$item.linkStyle}}">{{$item.link}}</text>
            </div>
            <text class="car-zone">{{$item.zone}} · {{$item.ip}}</text>
            <text class="car-meta">电量 {{$item.batteryText}}</text>
          </div>
        </div>

        <div class="note">
          <text class="note-title">异常闭环提示</text>
          <text class="note-text">{{alertText}}</text>
        </div>
      </div>

      <!-- ============ 右：任务清单与操作 ============ -->
      <div class="right">
        <text class="section-title">本轮任务清单</text>
        <div class="tasks">
          <div class="task" for="{{zones}}">
            <div class="task-line">
              <text class="task-zone">{{$item.name}}</text>
              <div class="badge" style="{{$item.badgeStyle}}">
                <text class="badge-text" style="{{$item.badgeTextStyle}}">{{$item.statusText}}</text>
              </div>
            </div>
            <text class="task-detail">{{$item.detail}}</text>
            <div class="task-foot">
              <text class="task-route">{{$item.route}} · {{$item.car}}</text>
              <text class="task-progress">进度 {{$item.progress}}%</text>
            </div>
            <div class="actions">
              <div class="btn btn-primary" tid="{{$item.id}}" onclick="onDispatch">
                <text class="btn-text-primary">派单</text>
              </div>
              <div class="btn" tid="{{$item.id}}" onclick="onCancel">
                <text class="btn-text">取消</text>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ 底部批量操作 ============ -->
    <div class="footer">
      <div class="dock-btn dock-primary" onclick="onStartAll">
        <text class="dock-text-primary">开始本轮巡检</text>
      </div>
      <div class="dock-btn" onclick="onCancelAll">
        <text class="dock-text">一键取消全部</text>
      </div>
      <text class="footer-hint">派单报文：任务序号 / 目标车辆 / 区域路线编号 / 取消标记</text>
    </div>
  </div>
</template>

