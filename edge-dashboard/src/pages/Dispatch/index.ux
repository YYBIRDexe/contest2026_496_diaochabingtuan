    text-align: right;
  }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import store from '../../common/store.js'
  import source from '../../common/source.js'

  export default {
    private: {
      headline: '—',
      alertText: '—',
      cars: [],
      zones: []
    },

    onInit() {
      this.refresh()
      const self = this
      source.onUpdate(function () {
        self.refresh()
      })
    },

    onShow() {
      this.refresh()
    },

    onRefresh() {
      this.refresh()
    },

    refresh() {
      const snap = source.get()
      if (!snap) {
        this.headline = '正在连接数据源…'
        return
      }

      const cars = snap.cars.map(function (c) {
        return Object.assign({}, c, {
          dotStyle: 'background-color: ' + (c.online ? '#3ddc84' : '#fbbf24'),
          linkStyle: 'color: ' + (c.online ? '#3ddc84' : '#fbbf24'),
          batteryText: c.online ? c.battery + '%' : '—'
        })
      })
      this.cars = cars

      const zones = snap.zones.map(function (z) {
        const st = store.statusOf(z.status)
        return Object.assign({}, z, {
          badgeStyle: 'background-color: ' + st.bg,
          badgeTextStyle: 'color: ' + st.color
        })
      })
      this.zones = zones

      const s = snap.summary
      this.headline = '已完成 ' + s.counts.done + ' / ' + s.total +
        ' · 阻塞 ' + s.counts.blocked + ' · 离线 ' + s.counts.offline

      const blocked = zones.filter(function (z) {
        return z.status === 'blocked'
      })
      if (blocked.length > 0) {
        this.alertText = blocked[0].name + '：' + blocked[0].detail +
          '。可按「一键取消全部」撤下未完成任务后重派。'
      } else {
        this.alertText = '当前没有待处理异常。'
      }
    },

    zoneIdOf(e) {
      return e && e.target && e.target.attr ? e.target.attr.tid : ''
    },

    /** 统一处理指令返回：可能是同步结果（演示）或 Promise（真实链路） */
    handle(result) {
      const self = this
      Promise.resolve(result).then(function (r) {
        prompt.showToast({ message: r && r.message ? r.message : '已下发', duration: 2000 })
        self.refresh()
      })
    },

    onDispatch(e) {
      const id = this.zoneIdOf(e)
      this.handle(source.dispatch(id))
    },

    onCancel(e) {
      const id = this.zoneIdOf(e)
      this.handle(source.cancel(id))
    },

    onStartAll() {
      const zones = this.zones.filter(function (z) {
        return z.status === 'idle' || z.status === 'blocked'
      })
      const self = this
      if (zones.length === 0) {
        prompt.showToast({ message: '没有待派发的任务', duration: 2000 })
        return
      }
      Promise.all(zones.map(function (z) {
        return Promise.resolve(source.dispatch(z.id))
      })).then(function (rs) {
        const ok = rs.filter(function (r) {
          return r && r.ok
        }).length
        prompt.showToast({
          message: '已派发 ' + ok + ' / ' + zones.length + ' 个任务',
          duration: 2500
        })
        self.refresh()
      })
    },

    onCancelAll() {
      this.handle(source.cancelAll())
    },

    goBack() {
      router.back()
    }
  }
</script>
