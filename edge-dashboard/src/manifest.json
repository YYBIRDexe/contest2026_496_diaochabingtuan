{
  "package": "com.velaguard.desktop",
  "name": "巡检桌面",
  "icon": "/common/logo.png",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minAPILevel": 1,
  "features": [
    { "name": "system.router" },
    { "name": "system.velaclaw" },
    { "name": "system.prompt" },
    { "name": "system.storage" },
    { "name": "system.network" }
  ],
  "permissions": [
    { "name": "hapjs.permission.DEVICE_INFO" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 1920,
    "designHeight": 1080
  },
  "display": {
    "backgroundColor": "#0B1220"
  },
  "router": {
    "entry": "Home",
    "pages": {
      "Home": {
        "component": "index",
        "path": "/"
      },
      "VoiceAssistant": {
        "component": "index",
        "path": "/voice"
      },
      "Dispatch": {
        "component": "index",
        "path": "/dispatch"
      },
      "Zones": {
        "component": "index",
        "path": "/zones"
      },
      "Records": {
        "component": "index",
        "path": "/records"
      },
      "System": {
        "component": "index",
        "path": "/system"
      }
    }
  }
}
