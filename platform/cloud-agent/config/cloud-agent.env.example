# VelaGuard cloud agent configuration example.
#
# The platform service reads this path:
#   /home/sunrise/.config/velaguard-cloud-agent/cloud-agent.env
# with mode 0600. The installer only creates a template when the file is
# absent; it never overwrites or prints an existing file.
#
# Never commit a real key. The supported path is a protected key file:
#   /home/sunrise/.config/velaguard-cloud-agent/deepseek.key
# The local key window (tools/platform-connect/configure-deepseek.py) writes
# both files with 0600 and removes legacy direct-key variables that would
# otherwise shadow the key file.
#
# Default provider: DeepSeek. Other OpenAI-compatible providers can override
# base_url/model. Leave the key file absent to deploy unconfigured: the UI and
# read-only tools work, POST /api/chat returns 503, and no mock answer is made.

CLOUD_AGENT_HOST=0.0.0.0
CLOUD_AGENT_PORT=8130

CLOUD_AGENT_LLM_BASE_URL=https://api.deepseek.com
CLOUD_AGENT_LLM_MODEL=deepseek-v4-flash
CLOUD_AGENT_LLM_API_KEY_FILE=/home/sunrise/.config/velaguard-cloud-agent/deepseek.key

# The platform may export http_proxy/https_proxy pointing at a dead host.
# "direct" ignores those variables; "env" honors them; a URL uses that proxy.
CLOUD_AGENT_LLM_PROXY=direct

CLOUD_AGENT_LLM_TIMEOUT_SECONDS=45
CLOUD_AGENT_LLM_MAX_TOKENS=900
CLOUD_AGENT_LLM_TEMPERATURE=0.1
CLOUD_AGENT_MAX_TOOL_ITERATIONS=6

# Optional browser/API access token. If set, all /api endpoints except
# /api/health require "Authorization: Bearer <token>".
CLOUD_AGENT_ACCESS_TOKEN=

# Keep proposals across releases. The installer sets this by default.
CLOUD_AGENT_STATE_DIR=/home/sunrise/.local/state/cloud-agent
