<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <!--
    2026-09-19 清理：组织委员会模板残留的三个占位样例已移除
    （app/hello_app、quickapp/hello_quickapp、board/contest_board —
    样例内仍写着 team 000），其 <linkfile> 一并删除。

    新增作品形态时，按同样规则在此补回对应的一条：

      <linkfile src="app/<你的app>"         dest="packages/demos/contest2026_496_<你的app>"/>
      <linkfile src="quickapp/<你的快应用>"  dest="packages/apps/contest2026_496_<你的快应用>"/>
      <linkfile src="board/<你的board>"      dest="vendor/openvela/boards/contest2026_496_<你的board>"/>
  -->
  <project path="contest2026_496_diaochabingtuan" name="contest2026_496_diaochabingtuan">
  </project>
</manifest>
