      { label: '开始巡检', q: '开始本轮巡检' },
      { label: '没查完的', q: '现在哪些区域没查完' },
      { label: '查车队', q: '现在四台车都在线吗，电量多少' },
      { label: '查路线', q: '本轮固定路线是怎么走的' },
      { label: '生成汇总', q: '生成本轮巡检汇总' },
