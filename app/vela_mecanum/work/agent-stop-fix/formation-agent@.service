[Unit]
Description=Distributed CZ225 MentorPi formation agent for %i
After=network-online.target docker.service mentorpi-localization.service mentorpi-localization-vendor-domain.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/default/openvela-formation
ExecStartPre=/opt/openvela-formation/scripts/stop_formation_agent.sh %i
ExecStart=/opt/openvela-formation/scripts/run_formation_agent.sh %i
ExecStop=/opt/openvela-formation/scripts/stop_formation_agent.sh %i
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
