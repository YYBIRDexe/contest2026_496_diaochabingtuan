[Unit]
Description=Distributed MentorPi formation agent for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openvela-formation
EnvironmentFile=/etc/default/openvela-formation
ExecStart=/opt/openvela-formation/scripts/run_formation_agent.sh %i
KillSignal=SIGINT
TimeoutStopSec=5
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
